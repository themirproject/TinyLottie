rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if request is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // 1. Users collection
    // - Users can read their own profile details
    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow write: if false; // Block client-side updates (prevents self-upgrading to PRO)
    }

    // 2. Coupons collection
    // - Handled strictly server-side in the /api/activate endpoint using Admin SDK
    match /coupons/{couponId} {
      allow read, write: if false;
    }

    // Helper: Check if user is an authorized admin
    function isAdmin() {
      return isAuth() && (
        request.auth.uid in ['Py3GTwTWhLbY1bVHmVLtoqjYDdP2', 'HYgHmkE0OqOqrAZD2q6N2KZEA7m1'] ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'emir.kalayci@gmail.com' ||
          request.auth.token.email.lower() == 'kalayci.emir@gmail.com'
        ))
      );
    }

    // 3. Usage Logs collection
    // - Authenticated users can log their own compressions
    // - Only authorized admins can read raw optimization logs (protects privacy & metrics)
    match /usage_logs/{logId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // 4. Analytics Events collection
    // - Anyone can log anonymous client-side events
    // - Only authorized administrators can read analytics events
    match /analytics_events/{eventId} {
      allow create: if true; // Open to write events
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
